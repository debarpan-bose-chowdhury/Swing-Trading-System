# syntax=docker/dockerfile:1
# Ticker Data System (migrator / updator / archiver). Separate from the health-service image because it
# needs pandas, pyarrow and yfinance. Stages run by overriding the command, e.g. `python -m app.market.migrator`.
FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/debarpan-bose-chowdhury/Swing-Trading-System"

WORKDIR /app

# Dependencies come from pyproject.toml (single source of truth); copied first so this layer caches.
COPY pyproject.toml .
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']))" \
    | pip install --no-cache-dir -r /dev/stdin

RUN addgroup --system --gid 10001 appgroup \
    && adduser --system --uid 10001 --ingroup appgroup --no-create-home appuser

COPY app ./app
RUN mkdir -p app/data && chown appuser:appgroup app/data

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER appuser

CMD ["python", "-m", "app.market.updator"]
