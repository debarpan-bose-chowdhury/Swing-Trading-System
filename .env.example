# Template for the Stock Analyst secrets. Copy to the HOST file
#   C:\ProgramData\ticker-pipeline\secrets\analyst.env
# (outside the data/ and config/ folders that are mounted into containers), fill in the real values and
# restrict the file to your Windows user (right-click > Properties > Security). Never commit the real file.
# Task Scheduler passes it with:  docker run --rm --env-file C:\ProgramData\ticker-pipeline\secrets\analyst.env ...
# Format: NAME=value, one per line, no quotes, no spaces around "=".
# A value that still looks like <set at deployment> is treated as missing.

# Angel One SmartAPI (Ledger and probe only)
ANGEL_API_KEY=<set at deployment>
ANGEL_CLIENT_CODE=<set at deployment>
ANGEL_MPIN=<set at deployment>
ANGEL_TOTP_SECRET=<set at deployment>

# Digest email (all stages; optional, an unconfigured send is logged and skipped)
SMTP_USER=<set at deployment>
SMTP_PASSWORD=<set at deployment>
